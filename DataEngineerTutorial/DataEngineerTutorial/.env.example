# ==== Postgres ====
POSTGRES_USER=gtp
POSTGRES_PASSWORD=gtp
POSTGRES_DB=github_trending
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# DB_URL dùng chung cho FastAPI (async) và Spark JDBC (sync)
DB_URL=postgresql+asyncpg://gtp:gtp@postgres:5432/github_trending
JDBC_URL=jdbc:postgresql://postgres:5432/github_trending

# ==== FastAPI ====
API_HOST=0.0.0.0
API_PORT=8000

# ==== Prometheus Pushgateway (etl-spark đẩy metrics lên) ====
PUSHGATEWAY_URL=http://pushgateway:9091

# ==== Frontend ====
API_BASE_URL=http://localhost:8000/api/v1
