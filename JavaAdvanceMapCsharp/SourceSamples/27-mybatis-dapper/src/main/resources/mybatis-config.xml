<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
  <settings>
    <setting name="cacheEnabled" value="false"/>
    <setting name="localCacheScope" value="STATEMENT"/>
    <setting name="defaultStatementTimeout" value="2"/>
  </settings>
  <environments default="lab">
    <environment id="lab">
      <transactionManager type="JDBC"/>
      <!-- Built-in pool keeps the lab self-contained. Production commonly injects
           Spring Boot's application-owned Hikari DataSource instead. -->
      <dataSource type="POOLED">
        <property name="driver" value="org.h2.Driver"/>
        <property name="url" value="jdbc:h2:mem:mybatis_course;DB_CLOSE_DELAY=-1"/>
        <property name="username" value="sa"/>
        <property name="password" value=""/>
      </dataSource>
    </environment>
  </environments>
  <mappers>
    <mapper resource="course/mybatis/InventoryMapper.xml"/>
  </mappers>
</configuration>
