<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.course</groupId>
  <artifactId>java-advanced-csharp-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <maven.compiler.version>3.13.0</maven.compiler.version>
    <maven.surefire.version>3.5.2</maven.surefire.version>
  </properties>

  <modules>
    <module>SourceSamples/01-runtime-types</module>
    <module>SourceSamples/02-domain-model</module>
    <module>SourceSamples/03-generics-collections</module>
    <module>SourceSamples/04-functional-streams</module>
    <module>SourceSamples/05-exceptions-resources</module>
    <module>SourceSamples/06-concurrency</module>
    <module>SourceSamples/07-jvm-memory</module>
    <module>SourceSamples/08-annotations-reflection</module>
    <module>SourceSamples/09-testing</module>
    <module>SourceSamples/10-sql-jdbc</module>
    <module>SourceSamples/11-architecture</module>
    <module>SourceSamples/12-capstone</module>
    <module>SourceSamples/13-standard-library</module>
    <module>SourceSamples/14-modules-classloading</module>
    <module>SourceSamples/15-concurrency-deep</module>
    <module>SourceSamples/16-spring-boot</module>
    <module>SourceSamples/17-jpa-hibernate</module>
    <module>SourceSamples/18-security</module>
    <module>SourceSamples/19-messaging</module>
    <module>SourceSamples/20-distributed-systems</module>
    <module>SourceSamples/21-resilience-cache</module>
    <module>SourceSamples/22-observability</module>
    <module>SourceSamples/23-networking-cloud</module>
    <module>SourceSamples/24-dsa-interview</module>
    <module>SourceSamples/25-system-design</module>
    <module>SourceSamples/27-mybatis-dapper</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
