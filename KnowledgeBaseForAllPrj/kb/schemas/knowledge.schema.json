{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/knowledge.schema.json",
  "title": "Canonical KB page frontmatter",
  "type": "object",
  "required": [
    "id", "title", "summary", "kind", "scope", "status", "owners", "tags",
    "valid_from", "recorded_at", "last_verified", "review_by", "confidence",
    "sensitivity", "sources", "relations"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3},
    "summary": {"type": "string", "minLength": 10},
    "kind": {"enum": ["catalog", "principle", "pattern", "standard", "runbook", "overview", "architecture", "requirement", "interface", "decision", "change", "lesson"]},
    "scope": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "proposed", "approved", "deprecated", "superseded"]},
    "owners": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "valid_from": {"type": "string", "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "recorded_at": {"type": "string", "format": "date"},
    "last_verified": {"type": "string", "format": "date"},
    "review_by": {"type": "string", "format": "date"},
    "confidence": {"enum": ["low", "medium", "high"]},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "sources": {"type": "array", "items": {"type": "string"}},
    "relations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
