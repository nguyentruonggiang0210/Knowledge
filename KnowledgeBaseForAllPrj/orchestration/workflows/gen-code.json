{
  "schema_version": "1.0",
  "id": "gen-code-default",
  "intent": "gen-code",
  "owner": "kb-orchestrator",
  "budget": {"max_concurrency": 3, "max_retries_per_node": 2},
  "nodes": [
    {
      "id": "discover",
      "skill": "gen-code",
      "objective": "Inspect instructions, contracts, implementation, tests, and protected changes.",
      "depends_on": [],
      "execution": "manager",
      "parallel_group": null,
      "read_set": ["AGENTS.md", "kb/**", "<target>/**"],
      "write_set": [],
      "output": "scoped delivery contract",
      "acceptance": ["behavior and write scope are explicit", "unknowns that change outcome are resolved"],
      "risk": "low",
      "approval": "none",
      "effects": {"resources": [], "side_effects": [], "idempotency_key": null, "exclusive_locks": []}, "retry": {"max_attempts": 1, "transient_only": true}
    },
    {
      "id": "implement",
      "skill": "gen-code",
      "objective": "Implement the approved behavior and focused tests within the frozen write scope.",
      "depends_on": ["discover"],
      "execution": "shared-workspace",
      "parallel_group": null,
      "read_set": ["<target>/**", "kb/projects/<project>/**"],
      "write_set": ["<approved-write-scope>/**"],
      "output": "integrated change set and test evidence",
      "acceptance": ["requested behavior is implemented", "unrelated user changes are preserved"],
      "risk": "medium",
      "approval": "before-run",
      "effects": {"resources": [], "side_effects": [], "idempotency_key": null, "exclusive_locks": []}, "retry": {"max_attempts": 2, "transient_only": true}
    },
    {
      "id": "test",
      "skill": "gen-code",
      "objective": "Run targeted and applicable broader deterministic checks on the integrated state.",
      "depends_on": ["implement"],
      "execution": "shared-workspace",
      "parallel_group": "quality-wave",
      "read_set": ["<target>/**"],
      "write_set": ["<build-artifacts>/**"],
      "output": "observed commands and results",
      "acceptance": ["blocking checks pass or failures are visible"],
      "risk": "low",
      "approval": "none",
      "effects": {"resources": [], "side_effects": [], "idempotency_key": null, "exclusive_locks": []}, "retry": {"max_attempts": 2, "transient_only": true}
    },
    {
      "id": "code-review",
      "skill": "review-code",
      "objective": "Independently review the integrated diff for actionable defects.",
      "depends_on": ["implement"],
      "execution": "read-only",
      "parallel_group": "quality-wave",
      "read_set": ["<target>/**"],
      "write_set": [],
      "output": "ranked findings",
      "acceptance": ["findings include location, trigger, impact, evidence, and remediation"],
      "risk": "low",
      "approval": "none",
      "effects": {"resources": [], "side_effects": [], "idempotency_key": null, "exclusive_locks": []}, "retry": {"max_attempts": 1, "transient_only": true}
    },
    {
      "id": "doc-review",
      "skill": "review-doc",
      "objective": "Check whether behavior, interfaces, and operations are documented consistently.",
      "depends_on": ["implement"],
      "execution": "read-only",
      "parallel_group": "quality-wave",
      "read_set": ["<target>/**", "kb/projects/<project>/**"],
      "write_set": [],
      "output": "documentation impact findings",
      "acceptance": ["source-of-truth and freshness impact are covered"],
      "risk": "low",
      "approval": "none",
      "effects": {"resources": [], "side_effects": [], "idempotency_key": null, "exclusive_locks": []}, "retry": {"max_attempts": 1, "transient_only": true}
    },
    {
      "id": "verify",
      "skill": "verify-delivery",
      "objective": "Verify the final integrated state against all acceptance criteria and evidence.",
      "depends_on": ["test", "code-review", "doc-review"],
      "execution": "read-only",
      "parallel_group": null,
      "read_set": ["<target>/**", "kb/projects/<project>/**"],
      "write_set": [],
      "output": "accept, accept-with-known-risk, or reject",
      "acceptance": ["every blocking criterion has final-state evidence"],
      "risk": "medium",
      "approval": "none",
      "effects": {"resources": [], "side_effects": [], "idempotency_key": null, "exclusive_locks": []}, "retry": {"max_attempts": 1, "transient_only": true}
    }
  ]
}
