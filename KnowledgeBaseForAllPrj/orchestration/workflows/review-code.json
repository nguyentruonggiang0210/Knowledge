      "depends_on": ["scope"], "execution": "read-only", "parallel_group": "review-lenses",
      "read_set": ["<target>/**"], "write_set": [], "output": "security findings",
      "acceptance": ["trust boundaries and negative paths are covered"],
      "risk": "low", "approval": "none", "effects": {"resources": [], "side_effects": [], "idempotency_key": null, "exclusive_locks": []}, "retry": {"max_attempts": 1, "transient_only": true}
