{
  "name": "summarize-knowledge-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "content:prepare": "npm run sync:sources && npm run validate:content",
    "predev": "npm run content:prepare",
    "dev": "vite",
    "prebuild": "npm run content:prepare",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "pretest": "npm run content:prepare",
    "test": "vitest run",
    "pretest:watch": "npm run content:prepare",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "sync:sources": "node scripts/sync-source-content.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "topic:new": "node scripts/create-topic.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
