@model (TvWeb.Models.Film Film, List<TvWeb.Models.Episode> Eps, TvWeb.Models.Episode Cur)
@{ ViewData["Title"] = "Xem " + Model.Film.TitleVi + " - Tập " + Model.Cur.EpIndex; var servers = (List<string>)ViewBag.Servers; var server = (string)ViewBag.Server; }
<div class="container-fluid px-3 px-lg-4 mt-3">
  <h4>@Model.Film.TitleVi <small class="text-secondary">— Tập @Model.Cur.EpIndex (@server)</small></h4>
  <div class="player-wrap">
    @if (!string.IsNullOrEmpty(Model.Cur.HlsUrl)) {
      <video id="player" class="video-js vjs-big-play-centered" controls preload="none" poster="@Model.Film.Poster" data-setup='{}'>
        <source src="@Model.Cur.HlsUrl" type="application/x-mpegURL" />
      </video>
    } else if (Uri.TryCreate(Model.Cur.PlayerUrl, UriKind.Absolute, out var externalUrl)
        && (externalUrl.Host.Equals("streamc.xyz", StringComparison.OrdinalIgnoreCase)
            || externalUrl.Host.EndsWith(".streamc.xyz", StringComparison.OrdinalIgnoreCase))) {
      <div class="ratio ratio-16x9 external-player">
        <div class="d-flex flex-column align-items-center justify-content-center text-center p-3">
          <p class="text-light mb-0">Nguồn phim này đang bị chặn và không thể phát. Vui lòng thử lại khi có nguồn khác.</p>
        </div>
      </div>
    } else if (!string.IsNullOrEmpty(Model.Cur.PlayerUrl)) {
      <div class="ratio ratio-16x9 external-player">
        <button type="button" class="external-play btn btn-danger" aria-label="Phát phim">▶ Phát phim</button>
        <iframe data-src="@Model.Cur.PlayerUrl" title="@Model.Film.TitleVi" allowfullscreen allow="autoplay; encrypted-media; fullscreen" referrerpolicy="no-referrer"></iframe>
      </div>
    } else {
      <div class="alert alert-warning">Chưa có link phát cho tập này.</div>
    }
  </div>
  @if (!string.IsNullOrEmpty(Model.Cur.HlsUrl)) {
    <div id="playback-failure" class="alert alert-warning mt-2 d-none" role="alert">
      Nguồn phim không phát được hoặc phản hồi quá chậm.
      <button type="button" id="retry-playback" class="btn btn-sm btn-outline-dark ms-2">Thử lại</button>
      @foreach (var other in Model.Eps.Where(x => x.ServerSlug != server && x.EpIndex == Model.Cur.EpIndex).GroupBy(x => x.ServerSlug).Select(x => x.First())) {
        <a class="btn btn-sm btn-outline-dark ms-2" href="/xem-phim/@Model.Film.Slug?server=@other.ServerSlug&ep=@other.EpIndex">Máy chủ @other.ServerSlug</a>
      }
    </div>
  }
  <div class="mt-3">
    <span class="me-2">Máy chủ:</span>
    @foreach (var s in servers) { <a class="btn @(s==server?"btn-danger":"btn-outline-light") btn-sm me-1" href="/xem-phim/@Model.Film.Slug?server=@s">@s</a> }
  </div>
  <div class="mt-2 ep-list">
    @foreach (var e in Model.Eps.Where(x => x.ServerSlug == server)) {
      <a class="btn @(e.EpIndex==Model.Cur.EpIndex?"btn-danger":"btn-outline-light") btn-sm m-1 ep-btn" data-ep="@e.EpIndex" href="/xem-phim/@Model.Film.Slug?server=@server&ep=@e.EpIndex">@e.EpIndex</a>
    }
  </div>
  <a class="btn btn-link text-secondary mt-2" href="/phim/@Model.Film.Slug">← Chi tiết phim</a>
</div>
@section Scripts { <script>TvWeb.rememberEp("@Model.Film.Slug", "@server", "@Model.Cur.EpIndex");</script> }
