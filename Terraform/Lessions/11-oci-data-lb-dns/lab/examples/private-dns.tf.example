# Private view phải thuộc resolver/VCN design của bạn.
resource "oci_dns_zone" "private" {
  compartment_id = var.compartment_id
  name           = "app.internal"
  zone_type      = "PRIMARY"
  scope          = "PRIVATE"
  view_id        = var.private_dns_view_id
  freeform_tags  = var.tags
}

resource "oci_dns_rrset" "api" {
  zone_name_or_id = oci_dns_zone.private.id
  domain          = "api.app.internal"
  rtype           = "A"
  scope           = "PRIVATE"
  view_id         = var.private_dns_view_id

  items {
    domain = "api.app.internal"
    rdata  = var.load_balancer_private_ip
    rtype  = "A"
    ttl    = 30
  }
}

