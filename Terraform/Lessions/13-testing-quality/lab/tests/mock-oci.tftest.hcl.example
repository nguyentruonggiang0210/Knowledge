# Example này chỉ dùng khi root module có required provider oci và oci_core_vcn.main.
mock_provider "oci" {
  mock_resource "oci_core_vcn" {
    defaults = {
      id    = "ocid1.vcn.oc1.ap-singapore-1.example"
      state = "AVAILABLE"
    }
  }
}

run "vcn_contract_without_credentials" {
  command = plan

  assert {
    condition     = oci_core_vcn.main.dns_label != ""
    error_message = "VCN phải bật DNS label."
  }
}

