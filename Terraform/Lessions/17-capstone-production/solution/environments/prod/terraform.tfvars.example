region         = "ap-singapore-1"
compartment_id = "ocid1.compartment.oc1..replace_prod"
oci_auth       = "APIKey"
oci_profile    = "TF-PROD"
name_prefix    = "payments"
vcn_cidr       = "10.80.0.0/16"

# Production sample mặc định plan core network, không tạo dịch vụ tính phí.
enable_nat_gateway   = false
enable_compute       = false
enable_load_balancer = false
lb_ingress_cidrs     = ["0.0.0.0/0"]

# Khi bật: tối thiểu hai stable keys ở AD/FD phù hợp, image đã promote.
instances      = {}
ssh_public_key = null

owner       = "platform-team"
cost_center = "payments"

