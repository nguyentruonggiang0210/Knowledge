aws_region   = "ap-southeast-1"
project_name = "tf-oci-bridge"
environment  = "lab"

vpc_cidr          = "10.20.0.0/16"
public_subnet_cidr = "10.20.1.0/24"

# Giữ false cho bài network-only. Khi bật true, EC2, EBS và public IPv4 có thể tính phí.
create_compute = false

# Chỉ dùng khi create_compute=true.
instance_type     = "t3.micro"
allowed_http_cidr = "0.0.0.0/0"
